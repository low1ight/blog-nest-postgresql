###
# INFRASTRUCTURE CONFIGURATIONS
###

# APP PORT
PORT=

# Testing module, provide useful controller that make testing more easily,
# for example DELETE ALL DATA, dangerous, recommended set false in most cases
INCLUDE_TESTING_MODULE=

#PostgeSQL
PG_PORT=
PG_USER_NAME=
