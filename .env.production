NODEMAILER_USER=
#gmail app password for example: nzty jyno lacc gbmq
NODEMAILER_PASSWORD=

###
#APPLICATION/DOMAIN SETTINGS
###

#Password hash rounds
BCRYPT_SALT_ROUNDS=10