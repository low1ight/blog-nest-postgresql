###
# INFRASTRUCTURE CONFIGURATIONS
###

# APP PORT
PORT=

# Testing module, provide useful controller that make testing more easily,
# for example DELETE ALL DATA, dangerous, recommended set false in most cases
INCLUDE_TESTING_MODULE=

# If "true" all registered user will be auto confirmed also disable sending confirmation email, 'false' for production
IS_USER_AUTO_CONFIRMED=

# PostgeSQL
PG_PORT=
PG_USER_NAME=
PG_PASSWORD=
PG_HOST=

# Nodemailer
# if true nodemailer will send letter while registration, password or another endpoints that include it
IS_NODEMAILER_ENABLE=
# nodemailer user gmail for example: qwerty@gmail.com
NODEMAILER_USER=
# gmail app password for example: nzty jyno lacc gbmq
NODEMAILER_PASSWORD=

###
# APPLICATION/DOMAIN SETTINGS
###

# Password hash rounds
BCRYPT_SALT_ROUNDS=10

